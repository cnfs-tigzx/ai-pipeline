  "项目简介": {
    "name": "WeKnora（维娜拉）",
    "vendor": "Tencent",
    "category": "企业级知识管理框架",
    "description": "开源的、基于大语言模型（LLM）的知识管理框架，面向企业级文档理解、语义检索与智能推理场景。把团队分散的文档汇集起来，用于检索、推理，并随资料更新持续维护。",
    "core_capabilities": {
      "RAG": "回答有据可查，混合检索、多模态解析、原文引用",
      "Agent": "用知识和工具完成任务，多步推理、技能与沙箱、本机浏览器、MCP 工具、长期记忆",
      "Wiki": "把文档整理成 Wiki，自动组织、知识图谱、版本回滚"
    },
    "highlights": [
      "技能可从 ClawHub / SkillHub / Git / ZIP 安装，在会话级持久的 Docker / E2B / Cube 沙箱中运行",
      "对话旁可打开交互式终端与图形桌面",
      "BrowserSkill 扩展可操作用户自己的 Chrome / Edge",
      "外部 MCP 服务（支持 OAuth）可接入，并按工具逐个启用",
      "跨会话长期记忆保存用户确认过的个人信息、偏好与事实",
      "文件夹上传保留原始目录结构",
      "检索分块可以编辑、比对与回滚"
    ]
  },
  "技术栈": {
    "后端": {
      "language": "Go",
      "version": "Go 1.26.0+",
      "config_files": ["go.mod", "go.sum", ".golangci.yml", ".air.toml"],
      "hot_reload": "Air",
      "note": "进程内 anydoc 解析 Office 文档"
    },
    "前端": {
      "language": "TypeScript",
      "framework": "Vue",
      "config_files": ["frontend/package.json", "frontend/Dockerfile"],
      "features": ["热重载", "TypeScript 类型检查"]
    },
    "MCP Server": {
      "language": "Python（已弃用）",
      "status": "内置 MCP Server（Go 实现）为主；Python 版 mcp-server/ 已弃用",
      "config_files": ["mcp-server/requirements.txt", "mcp-server/pyproject.toml", "mcp-server/Dockerfile"]
    },
    "文档解析": {
      "module": "docreader",
      "config_files": ["docreader/pyproject.toml"],
      "engine": "anydoc（Go 进程内 Office 解析）、PaddleOCR-VL、OpenDataLoader"
    },
    "文档站": {
      "language": "JavaScript/TypeScript",
      "runtime": "Node.js 24",
      "config_files": ["website-docs/package.json", "website-docs/Dockerfile"]
    },
    "CLI": {
      "name": "weknora",
      "language": "Go",
      "location": "cli/"
    },
    "小程序": {
      "config_files": ["miniprogram/package.json"]
    },
    "部署技术": ["Docker", "Docker Compose", "Kubernetes (Helm)", "SQLite (Lite 模式)"]
  },
  "依赖": {
    "运行时依赖": {
      "必需": [
        {"name": "Docker", "purpose": "容器化部署"},
        {"name": "Docker Compose", "purpose": "多服务编排"},
        {"name": "Git", "purpose": "代码克隆"}
      ],
      "可选": [
        {"name": "Ollama", "purpose": "本地大模型推理（向量模型与 LLM）", "启动": "ollama serve > /dev/null 2>&1 &"}
      ]
    },
    "外部组件_Docker_Compose编排": {
      "核心服务": "后端 API、前端 Web UI、数据库等",
      "可选_profile": [
        {"profile": "full", "说明": "全部功能"},
        {"profile": "neo4j", "说明": "知识图谱 (Neo4j)"},
        {"profile": "minio", "说明": "对象存储 (MinIO)"},
        {"profile": "langfuse", "说明": "链路追踪 (Langfuse)"}
      ]
    },
    "模型厂商_内置29家": [
      "OpenAI", "Azure OpenAI", "Anthropic", "DeepSeek", "Qwen（阿里云）",
      "智谱", "混元", "豆包（火山引擎）", "Gemini", "MiniMax", "NVIDIA",
      "SiliconFlow", "OpenRouter", "LiteLLM", "Ollama"
    ],
    "向量数据库_可选": [
      "PostgreSQL (pgvector + ParadeDB)", "Elasticsearch", "OpenSearch",
      "Milvus", "Weaviate", "Qdrant", "Apache Doris", "腾讯云 VectorDB"
    ],
    "对象存储_可选": [
      "本地", "腾讯云 COS", "MinIO", "AWS S3", "火山引擎 TOS",
      "阿里云 OSS", "金山云 KS3", "华为云 OBS"
    ],
    "数据源": [
      "飞书知识库", "飞书云盘", "Lark", "Confluence", "GitLab",
      "腾讯 IMA", "Notion", "语雀", "钉钉文档", "Seafile", "RSS"
    ],
    "IM渠道": [
      "企业微信", "飞书", "Lark", "QQBot", "Slack", "Telegram",
      "钉钉", "Mattermost", "微信", "云之家"
    ],
    "网络搜索": [
      "DuckDuckGo", "Bing", "Google", "Tavily", "Baidu", "Ollama",
      "SearXNG", "Keenable", "智谱 AI", "Exa", "Metaso", "博查", "Serply", "SearchApi"
    ],
    "文档格式": [
      "PDF", "Word", "PPT", "Excel", "CSV", "TXT", "Markdown",
      "HTML", "EPUB", "MHTML", "JSON", "XMind", "图片"
    ]
  },
  "启动命令": {
    "Docker_Compose部署": {
      "steps": [
        "git clone https://github.com/Tencent/WeKnora.git",
        "cd WeKnora",
        "cp .env.example .env    # 按需编辑 .env",
        "docker compose pull     # 拉取最新镜像",
        "docker compose up -d    # 启动核心服务"
      ]
    },
    "可选服务启动": "docker compose --profile neo4j --profile minio up -d",
    "停止服务": "docker compose down",
    "版本升级": {
      "steps": [
        "# 在 .env 中将 WEKNORA_VERSION 设为目标版本",
        "docker compose pull",
        "docker compose up -d"
      ]
    },
    "开发模式": {
      "steps": [
        "make dev-start      # 启动基础设施",
        "make dev-app        # 启动后端（新终端）",
        "make dev-frontend   # 启动前端（新终端）"
      ],
      "note": "前端自动热重载；后端5-10秒重启（Air）；无需重建Docker镜像"
    },
    "本地Ollama": "ollama serve > /dev/null 2>&1 &",
    "文档站预览": "cd website-docs && npm run setup && npm run build && npm run preview"
  },
  "构建方式": {
    "标准部署": "Docker Compose（docker-compose.yml）",
    "开发环境": "docker-compose.dev.yml + Makefile",
    "Kubernetes": "Helm Chart（helm/ 目录）",
    "Lite单二进制": "零外部依赖（SQLite + 内存队列）",
    "桌面应用": "带图形界面的Lite运行时，需自行构建",
    "前端构建": "frontend/ 目录，npm构建 + Dockerfile",
    "代码格式化检查": {
      "fmt": "make fmt（gofmt）",
      "lint": "make lint（golangci-lint）",
      "test": "make test"
    }
  },
  "配置项": {
    "主配置文件": ".env（从 .env.example 复制）",
    "配置示例": {
      "标准": ".env.example（约53KB，约150个环境变量）",
      "Lite": ".env.lite.example（约4KB）"
    },
    "关键环境变量": [
      {"name": "WEKNORA_VERSION", "purpose": "指定部署版本"},
      {"name": "OLLAMA_BASE_URL", "purpose": "Ollama服务地址"},
      {"name": "WEKNORA_API_KEY", "purpose": "CI场景API Key"},
      {"name": "WEKNORA_HOST", "purpose": "CI场景服务地址"}
    ],
    "配置文档": "https://weknora.weixin.qq.com/docs/01-getting-started/04-configuration",
    "其他配置文件": [".air.toml", ".golangci.yml", ".dockerignore", "config/目录"]
  },
  "接口": {
    "访问地址": {
      "Web_UI": "http://localhost",
      "后端API": "http://localhost:8080",
      "链路追踪_Langfuse": "http://localhost:3000"
    },
    "API总览": "约360个API端点（REST），文档见官方API总览页",
    "MCP_Server": {
      "type": "Streamable HTTP",
      "endpoint": "/mcp/<endpoint_id>",
      "features": "每个端点独立令牌、知识库范围、限流与工具分组",
      "cli_serve": "weknora mcp serve"
    },
    "CLI示例": [
      "weknora profile add prod --host https://kb.example.com --use",
      "weknora auth login",
      "weknora kb list",
      "weknora link --kb my-knowledge-base",
      "weknora doc upload notes.md",
      "weknora chat \"总结一下设计文档\""
    ],
    "Go_SDK": "知识库、文档、会话等资源的CRUD与SSE流式问答"
  },
  "已知坑": [
    {
      "issue": "版本不一致风险",
      "detail": "仅执行docker compose up -d会复用本地缓存镜像，可能导致Web UI显示版本与release不一致",
      "mitigation": "升级前必须先docker compose pull，阅读升级须知"
    },
    {
      "issue": "安全部署警告",
      "detail": "生产环境强烈建议部署在内网/私有网络，避免直接暴露公网",
      "mitigation": "配置防火墙规则，定期更新版本"
    },
    {
      "issue": "不兼容变更_v0.8.2",
      "detail": "钉钉频道仅支持Stream模式；沙箱命令默认以root执行",
      "mitigation": "升级时阅读升级须知"
    },
    {
      "issue": "Python_MCP_Server已弃用",
      "detail": "mcp-server/下Python版MCP服务已弃用",
      "mitigation": "迁移到内置Go版MCP Server"
    },
    {
      "issue": "make_fmt注意事项",
      "detail": "make fmt会格式化整个Go仓库",
      "mitigation": "仅在工作区干净时运行，检查diff"
    },
    {
      "issue": "全量测试环境依赖",
      "detail": "部分全量测试依赖本地基础设施或服务配置",
      "mitigation": "PR中提供改动范围内通过的定向测试"
    },
    {
      "issue": "数据库迁移",
      "detail": "版本升级需核对数据库迁移、飞书重同步、沙箱复用开关",
      "mitigation": "阅读对应版本升级须知"
    }
  ],
