{
  "repo": "mem0",
  "repo_url": "https://github.com/mem0ai/mem0",
  "local_path": "/Users/tigzx/workspace/ai-pipeline/repos/mem0",
  "clone_method": "ssh (git@github.com:mem0ai/mem0.git)",
  "readme_files": ["README.md"],
  "project_name": "Mem0",
  "project_description": "The Memory Layer for AI Agents - Drop-in memory infrastructure for AI agents and apps. Context that persists. Built for production.",
  "tech_stack": {
    "language": "Python (server) + TypeScript (dashboard)",
    "runtime": "Python 3.12 + Node.js 20",
    "framework": "FastAPI (server) + Next.js 15 (dashboard)",
    "database": "PostgreSQL 17 + pgvector 0.8.0",
    "build_tool": "Docker (docker-compose)",
    "project_type": "docker (self-hosted SaaS)",
    "llm_default": "OpenAI gpt-5-mini",
    "embedder_default": "OpenAI text-embedding-3-small"
  },
  "dependencies": {
    "server": ["FastAPI", "uvicorn", "sqlalchemy", "alembic", "mem0ai", "smol-toml", "psycopg2"],
    "dashboard": ["Next.js 15", "React", "TypeScript"],
    "database": ["PostgreSQL 17", "pgvector 0.8.0"]
  },
  "deploy_mode": "docker",
  "docker_services": {
    "mem0": {
      "image": "mem0-dev-mem0 (local build)",
      "port": "8888->8000",
      "description": "FastAPI REST API Server"
    },
    "postgres": {
      "image": "pgvector/pgvector:pg17",
      "port": "8432->5432",
      "description": "PostgreSQL + pgvector 向量数据库"
    },
    "mem0-dashboard": {
      "image": "mem0-dev-mem0-dashboard (local build)",
      "port": "3000->3000",
      "description": "Next.js Web 管理后台"
    }
  },
  "build_commands": {
    "start": "cd server && docker compose up -d --build",
    "stop": "cd server && docker compose down",
    "bootstrap": "cd server && make bootstrap",
    "health": "cd server && make health"
  },
  "access_urls": {
    "dashboard": "http://localhost:3000",
    "api": "http://localhost:8888",
    "openapi_docs": "http://localhost:8888/docs"
  },
  "env_config": {
    "required": ["OPENAI_API_KEY", "POSTGRES_PASSWORD", "JWT_SECRET"],
    "optional": ["ANTHROPIC_API_KEY", "GOOGLE_API_KEY", "ADMIN_API_KEY"],
    "defaults": {
      "LLM": "gpt-5-mini",
      "Embedder": "text-embedding-3-small",
      "Vector Store": "Postgres + pgvector"
    }
  },
  "security": {
    "auth": "JWT (dashboard login) + X-API-Key (programmatic access)",
    "auth_disabled_by_default": false,
    "rate_limiting": true
  },
  "multi_user": {
    "supported": true,
    "isolation": "user_id + agent_id + org_id",
    "api_key_per_user": true
  },
  "client_plugins": ["Claude Code", "Codex", "Cursor", "Kimi"],
  "sdk": ["Python (pip install mem0ai)", "TypeScript (npm install mem0ai)"],
  "ports": [8888, 3000, 8432],
  "has_docker": true,
  "has_docker_compose": true,
  "has_env_file": true,
  "has_env_example": true,
  "known_issues": [
    "Docker Hub 不可达，需用 crane + 镜像源拉取基础镜像",
    "OrbStack HTTP 代理 (proxy.orb.internal:8305) 故障导致 docker pull 返回 Bad Gateway",
    "OPENAI_API_KEY 为空时 mem0 API 初始化失败（预期行为）",
    "dashboard yarn install 在容器内网络不稳定（ECONNRESET），但自动重试可成功"
  ],
  "license": "Apache 2.0",
  "version": "latest (main branch)"
}
