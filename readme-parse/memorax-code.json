{
  "repo": "memorax-code",
  "repo_url": "https://github.com/memorax-ai/memorax-code",
  "local_path": "/Users/tigzx/workspace/ai-pipeline/repos/memorax-code",
  "clone_method": "ssh (git@github.com:memorax-ai/memorax-code.git)",
  "readme_files": ["README.md", "README.zh.md"],
  "preferred_readme": "README.zh.md",
  "project_name": "MemoraX Code",
  "project_description": "为 Codex、Claude Code、CodeBuddy CLI、WorkBuddy、DeepSeek Harness、OpenCode、Trae、Cursor 和 Qoder 共享一套能够持续积累记忆的 CLI 工具。沉淀代码任务中的工程经验，持续整理仓库知识，并在后续任务中找回相关的工作流程和偏好。",
  "tech_stack": {
    "language": "TypeScript",
    "runtime": "Node.js (>=20, 推荐 Node.js 24 LTS)",
    "build_tool": "tsc (TypeScript compiler)",
    "package_manager": "npm (package-lock.json)",
    "project_type": "monorepo (npm CLI library)",
    "monorepo_structure": {
      "packages/ts/": "TypeScript 源码包（backend + 9个适配器）",
      "packages/npm/": "npm 发布包 staging"
    }
  },
  "dependencies": {
    "runtime": ["smol-toml@^1.8.0"],
    "dev": ["typescript@^5.9.0", "@types/node@^20.0.0"]
  },
  "build_commands": {
    "install": "npm ci --prefix packages/ts/memorax-code-backend",
    "compile": "npx tsc (in packages/ts/memorax-code-backend)",
    "npm_staging": "bash scripts/build-npm-packages.sh"
  },
  "build_artifacts": {
    "ts_dist": "packages/ts/memorax-code-backend/dist/",
    "npm_staging": "dist/npm/memorax-code/",
    "entry_points": [
      "dist/memorax-code.js",
      "dist/server.js"
    ]
  },
  "deploy_mode": "native",
  "deploy_submode": "npm-library",
  "deploy_note": "npm 资源包项目：仅执行 build，验证产物完整性（入口文件存在、package.json main/module/exports 字段指向正确），不启动服务",
  "cli_commands": {
    "install_global": "npm install -g @memorax/memorax-code",
    "setup_existing": "memorax-code setup --existing-account",
    "setup_trial": "memorax-code setup",
    "status": "memorax-code status",
    "version": "memorax-code --version",
    "update": "memorax-code update",
    "uninstall": "memorax-code uninstall"
  },
  "supported_clients": [
    "Codex", "Claude Code", "CodeBuddy CLI", "WorkBuddy",
    "DeepSeek Harness (DSH)", "OpenCode", "Trae", "Cursor", "Qoder"
  ],
  "memory_types": {
    "Coding Memory": "已验证的修复、失败方案、设计依据、常见陷阱和非回归检查",
    "Repo Memory": "架构地图、模块职责、代码入口，以及 Commit、PR、MR 和 Issue 等历史证据",
    "Personal Memory": "User Profile 中记录的语言、语气、解释深度和结果呈现偏好",
    "Procedure Memory": "可复用的步骤、检查清单、前置条件、例外情况和验证要求"
  },
  "config_locations": {
    "default_home": "~/.memorax-code/",
    "config_file": "~/.memorax-code/config.toml",
    "personal_memory": "~/.memorax-code/personal-memory/",
    "env_override": "MEMORAX_CODE_HOME"
  },
  "ports": [],
  "has_docker": false,
  "has_docker_compose": false,
  "has_env_file": false,
  "has_env_example": false,
  "known_issues": [
    "DSH 版本要求 Node.js ^22.19.0 || >=24.0.0",
    "Linux 游客凭据管理需要 libsecret 提供的 /usr/bin/secret-tool",
    "Cursor 自动 Add 需要带内置 SQLite 的 Node.js 22.13+",
    "Trae 需手动开启 Global Hooks 开关",
    "HTTPS 克隆超时（需使用 SSH 协议）"
  ],
  "license": "MIT",
  "version": "0.1.22"
}
