<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- ai-three-center 门户常驻服务（由 scripts/indexpage-service.sh install 生成安装，路径自动替换） -->
<dict>
    <key>Label</key><string>com.ai-three-center.indexpage</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__ROOT__/scripts/control_server.py</string>
        <string>8765</string>
    </array>
    <key>WorkingDirectory</key><string>__ROOT__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key><string>__ROOT__/output/indexpage-service.log</string>
    <key>StandardErrorPath</key><string>__ROOT__/output/indexpage-service.log</string>
    <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
